# Copie para javva.env e preencha. javva.env NUNCA vai para o git.
# (No servidor da casa ele e gerado por: python gerar_env.py --pedir-token)

# Mongo onde ficam maquinas, sessoes e uso (collections javva_*_claude).
# Com o docker-compose.avulso.yml o Mongo sobe junto: deixe como esta.
JAVVA_MONGO_URI=mongodb://mongo:27017/?directConnection=true
JAVVA_DB=javva

# Conta do modelo. Use UMA das tres:
#  - token da sua assinatura (gerado por `claude setup-token`, comeca com sk-ant-oat)
CLAUDE_CODE_OAUTH_TOKEN=
#  - ou chave de API do Console (obrigatoria se outras pessoas forem usar)
# ANTHROPIC_API_KEY=

# Modelo e profundidade padrao (o plugin pode pedir outra profundidade).
JAVVA_MODELO=opus
JAVVA_ESFORCO=high
JAVVA_ULTRACODE=0

# 1 = maquina nova entra sozinha; 0 = precisa de "admin.py aprovar <codigo>"
JAVVA_AUTOAPROVAR=1
# Teto de tokens/dia por maquina (0 = sem teto) e limite de segundos por comando
JAVVA_LIMITE_PADRAO=0
JAVVA_LIMITE_CMD=180
